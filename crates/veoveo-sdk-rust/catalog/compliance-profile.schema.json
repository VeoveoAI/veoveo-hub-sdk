{
  "$defs": {
    "ComplianceItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/RequirementId"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ComplianceStatus"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "ComplianceProfileFormat": {
      "description": "The format of a server's compliance declaration.",
      "enum": [
        "https://veoveo.ai/formats/hosted-mcp-compliance"
      ],
      "namingProfile": {
        "role": {
          "kind": "scalar",
          "profile": {
            "grammar": "format_uri",
            "kind": "builtin"
          }
        }
      },
      "type": "string"
    },
    "ComplianceStatus": {
      "enum": [
        "met",
        "pending"
      ],
      "type": "string"
    },
    "ContractId": {
      "description": "The hosted MCP server contract this crate defines.",
      "enum": [
        "https://veoveo.ai/contracts/hosted-mcp"
      ],
      "namingProfile": {
        "role": {
          "kind": "scalar",
          "profile": {
            "grammar": "contract_uri",
            "kind": "builtin"
          }
        }
      },
      "type": "string"
    },
    "RequirementId": {
      "enum": [
        "C01",
        "C02",
        "C03",
        "C04",
        "C05",
        "C06",
        "C07",
        "C08",
        "C09",
        "C10",
        "C11",
        "C12",
        "C13",
        "C14",
        "C15",
        "C16",
        "C17",
        "C18",
        "C19",
        "C20",
        "C21",
        "C22",
        "C23",
        "C24",
        "C25",
        "C26",
        "C27",
        "C28",
        "C29",
        "C30",
        "C31",
        "C33"
      ],
      "namingProfile": {
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_sdk_rust::docs::catalog"
              },
              "profile": "requirement-catalog-identity",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "type": "string"
    },
    "ServerSlug": {
      "description": "Canonical name of a registered server: its schema, URI scheme and route name.",
      "namingProfile": {
        "role": {
          "kind": "scalar",
          "profile": {
            "grammar": "server_slug",
            "kind": "builtin"
          }
        }
      },
      "type": "string"
    }
  },
  "$id": "https://veoveo.ai/formats/hosted-mcp-compliance",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compliance": {
      "items": {
        "$ref": "#/$defs/ComplianceItem"
      },
      "maxItems": 32,
      "minItems": 32,
      "type": "array"
    },
    "contract": {
      "$ref": "#/$defs/ContractId"
    },
    "format": {
      "$ref": "#/$defs/ComplianceProfileFormat"
    },
    "server": {
      "$ref": "#/$defs/ServerSlug"
    }
  },
  "required": [
    "format",
    "contract",
    "server",
    "compliance"
  ],
  "title": "ComplianceProfile",
  "type": "object"
}
